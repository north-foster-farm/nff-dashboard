{
  "name": "nff-dashboard",
  "private": true,
  "version": "0.10.99-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint 'src/**/*.css' 'public/style-guide/assets/*.css'",
    "check": "npm run lint && npm run test:coverage && bash scripts/check-format.sh",
    "check:supply": "node scripts/supply/check.mjs package-lock.json mcp/package-lock.json",
    "check:audit": "node scripts/audit/check.mjs --actions .github/workflows package-lock.json mcp/package-lock.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:partition": "node scripts/test-schedule-partition.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/supabase-js": "2.111.0",
    "ajv": "8.20.0",
    "dompurify": "3.4.16",
    "lucide-react": "1.28.0",
    "marked": "18.0.7",
    "pluralize": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rrule": "2.8.1",
    "suncalc": "1.9.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "vite": "5.4.21",
    "vitest": "4.1.10"
  }
}
