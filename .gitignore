node_modules
dist
.DS_Store
.vite
*.log
.branches
.temp

# Local DB backups (scripts/backup-db.mjs) — may contain real data.
.backups

# Scratch workspace. Untracked BY DESIGN and declared here rather than
# relying on a global ~/.gitignore: it currently holds live credentials,
# so on a clone without that global rule a `git add -A` would stage
# them. Durable material belongs in docs/, never here.
.ignored/

# Env files with secrets. .env.example is committed as a setup reference;
# every real .env / .env.local stays local.
.env
.env.local
.env.*.local

# Override global config for migration SQL files
!supabase/migrations/*.sql

# Raw audit screen recordings — large, may contain anything on screen.
audits/raw/
# Processed transcripts + frames (intermediate; findings.md is the keeper).
audits/*/processed/
.playwright-mcp/
coverage/
