# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example is committed as a setup reference.

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Supabase: Project Settings → API Keys (use the new sb_publishable_... format).
# The publishable key is safe to ship in the client bundle — RLS protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web push (Batch 11.3). Generate once with
# `node scripts/generate-vapid-keys.mjs` and copy the values it prints.
# The public key is safe to ship in the client; the private key stays in
# Netlify env vars (below) and never touches a frontend bundle.
VITE_VAPID_PUBLIC_KEY=

# ── Netlify functions ──────────────────────────────────────────────────────
# Consumed at Netlify runtime only. Locally, only needed if you run
# `netlify dev` to test the functions against Supabase.
#
# Same URL as VITE_SUPABASE_URL, un-prefixed. Required as its own line:
# scripts/prod-read.sh greps .env.local for `SUPABASE_URL=` and has no
# fallback.
SUPABASE_URL=

# SUPABASE_SECRET_KEY is the sb_secret_... key from Supabase → API Keys →
# Secret keys. Bypasses RLS so the heartbeat + push functions can read /
# write without a logged-in user. Never prefix with VITE_ — that would
# bake the secret into the client bundle.
SUPABASE_SECRET_KEY=

# Push trigger (Batch 11.3). Pair to VITE_VAPID_PUBLIC_KEY above. Subject
# is "mailto:" or "https://" — push services use it as the "who is sending
# this push" hint. See scripts/generate-vapid-keys.mjs.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
