# Staging values (F1.2, #74). Copy to .env.staging.local and fill in
# from the STAGING Supabase project (F1.1, #73), never production's.
# .env.staging.local is gitignored (.env.*.local); this sample is
# committed.
#
# The same names as .env.example. `vite --mode staging` loads this file
# over .env.local, but a name left out here falls through to
# .env.local, which is production: set every line.
#
# Generate a separate VAPID pair for staging with
# `node scripts/generate-vapid-keys.mjs`, so a staging push can never
# reach a production subscription.

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=

# ── Netlify functions and scripts ──────────────────────────────────────────
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
